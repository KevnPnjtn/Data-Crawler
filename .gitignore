# --- MyRobin Crawler local secrets and runtime ---
.env
.env.*
!.env.example
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Authentication/session state — never commit
.playwright_ig_profile/
*.session
*.session-journal
*.session-wal
*.session-shm

# Local logs, raw source material, temporary/interim data, and releases
# Keep directory placeholders if needed, but do not commit collected source material.
data/logs/*
!data/logs/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/interim/
data/released/*.csv

# OCR/model caches and generated temporary files
.cache/
.cache_ocr/
.paddleocr/
*.tmp
*.part